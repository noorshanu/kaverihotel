# Copy to .env.local for local dev, and add the same keys in Vercel/hosting dashboard.

# Public site URL (no trailing slash) — used for SEO, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.kaveripalace.com


# Google Apps Script web app URL (Deploy → Web app → copy URL ending in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=

# Must match SHEETS_WEBHOOK_SECRET in scripts/google-sheets-webhook.gs
SHEETS_WEBHOOK_SECRET=
